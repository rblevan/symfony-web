{# templates/accueil/index.html.twig #}
{% extends 'layout/site_layout.html.twig' %}

{% block title %}Bienvenue{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/accueil.css') }}"> {# Feuille CSS spécifique Niveau 3  #}
{% endblock %}

{% block content %}
    <h1>Bienvenue sur notre boutique !</h1>
    <p>Vous êtes un
        {% if is_granted('ROLE_SUPER_ADMIN') %}super-administrateur
    {% elseif is_granted('ROLE_ADMIN') %}administrateur
    {% elseif is_granted('ROLE_USER') %}client
    {% else %}visiteur anonyme{% endif %}.
        {% if app.user and app.user.pays %} Provenance : {{ app.user.pays.nom }}{% endif %}
    </p>
{% endblock %}
