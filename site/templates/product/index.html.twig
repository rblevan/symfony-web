{% extends 'layout/site_layout.html.twig' %}

{% block title %}Boutique - Liste des produits{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# Tu peux ajouter un CSS spécifique ici si besoin #}
    <link rel="stylesheet" href="{{ asset('css/site.css') }}">
{% endblock %}

{% block content %}
    <h1>Nos Produits</h1>

    {% for produit in produits %}
        <div class="produit-ligne" style="margin-bottom: 10px; padding: 5px; border-bottom: 1px solid #ccc;">
            <strong>{{ produit.libelle }}</strong> -
            <span>{{ produit.prixUnitaire }} €</span> -
            <span>En stock : {{ produit.quantiteStock }}</span>

            {# Récupération de la quantité déjà dans le panier pour ce produit #}
            {% set qte_dans_panier = 0 %}
            {% for ligne in app.user.paniers %}
                {% if ligne.product.id == produit.id %}
                    {% set qte_dans_panier = ligne.quantite %}
                {% endif %}
            {% endfor %}

            {# Condition d'affichage du formulaire [cite: 251-254] #}
            {% if produit.quantiteStock > 0 or qte_dans_panier > 0 %}
                <form action="{{ path('app_produits') }}" method="POST" style="display:inline;">
                    <input type="hidden" name="id_produit" value="{{ produit.id }}">

                    <select name="quantite">
                        {# Le menu va de 0 à m + n [cite: 251] #}
                        {% for i in 0..(qte_dans_panier + produit.quantiteStock) %}
                            {# L'entrée présélectionnée doit être "0" [cite: 251] #}
                            <option value="{{ i }}" {% if i == 0 %}selected{% endif %}>
                                {{ i }}
                            </option>
                        {% endfor %}
                    </select>

                    <button type="submit">Modifier</button>
                </form>
            {% else %}
                <span style="color: red;">(Indisponible)</span>
            {% endif %}
        </div>
    {% endfor %}
{% endblock %}
